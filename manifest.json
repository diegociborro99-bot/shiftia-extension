{
  "manifest_version": 3,
  "name": "Shiftia — Consejero, Secretario, Sabio",
  "version": "0.1.0",
  "description": "Asiste a la supervisora dentro de Actais: lee la planilla, sugiere cambios respetando convenio y redacta comunicaciones. Sin coste por uso.",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "sidePanel",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "*://personal.hospitaldejove.com/*",
    "https://shiftia-director-production.up.railway.app/*"
  ],
  "background": {
    "service_worker": "background/sw.js",
    "type": "module"
  },
  "action": {
    "default_title": "Shiftia",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": ["*://personal.hospitaldejove.com/*"],
      "js": ["content/detector.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["content/page-bridge.js"],
      "matches": ["*://personal.hospitaldejove.com/*"]
    }
  ]
}
